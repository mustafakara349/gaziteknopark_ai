# .gitignore for Gazi Teknopark AI Monorepo

# Sensitive configuration files (MUST NOT BE PUSHED)
.env
.env.local
.env.*.local
*.env
nginx/certs/*.key
nginx/certs/*.crt
nginx/certs/*.pem

# Python environment and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv
venv
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node/React dependencies and builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.vite

# IDEs and OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehgspider.out
*.sublime-project
*.sublime-workspace
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local test uploads or temp files
backend/tmp/
backend/uploads/
*.log
