# ==========================================
# GAZI TEKNOPARK - KURUMSAL BILGI ASISTANI
# ORTAM DEGISKENLERI (ENVIRONMENT VARIABLES)
# ==========================================

# API Sunucu Ayarları
PROJECT_NAME="Gazi Teknopark Kurumsal Bilgi Asistanı"
JWT_SECRET_KEY="gazi_tekno_super_secret_key_2026_degistirin"

# Veritabanı Bağlantı Ayarları (Docker ortamı için varsayılanlar)
DATABASE_URL="postgresql://gazi_admin:secure_db_password_123@postgres:5432/gazi_assistant"
REDIS_URL="redis://redis:6379/0"
QDRANT_URL="http://qdrant:6333"
OLLAMA_URL="http://ollama:11434"

# Model Seçimleri
LLM_MODEL="qwen2.5:1.5b"
EMBEDDING_MODEL="bge-m3"

# LDAP Entegrasyon Ayarları (Aktif etmek için True yapın)
LDAP_ENABLED=False
LDAP_SERVER_URL="ldap://ldap.gazi.local:389"
LDAP_BASE_DN="dc=gazi,dc=local"
LDAP_USER_DN_PATTERN="uid={username},ou=users,dc=gazi,dc=local"
LDAP_ADMIN_GROUP="admin-group"
